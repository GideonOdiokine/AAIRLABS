# Voice input (Phase 3) — Groq speech-to-text (OpenAI-compatible Whisper, free tier).
# Copy this file to `.env`, add your key, and restart the dev server.
# `.env` is gitignored; never commit a real key.
#
# Get a free key at https://console.groq.com (no credit card required).
# Expo inlines EXPO_PUBLIC_* variables into the client bundle at build time.
EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key-here
